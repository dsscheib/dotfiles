[user]
	name = Daniel Scheib
	email = dsscheib@gmail.com

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[pull]
	rebase = true

[rebase]
	autoStash = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[core]
	editor = nvim
	autocrlf = input
	excludesfile = ~/.config/git/ignore

# Machine-specific settings (credential helpers, work email, ...)
[include]
	path = ~/.gitconfig.local
